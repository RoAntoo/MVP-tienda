DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/ebooks"
ADMIN_API_KEY="genera-un-secreto-aleatorio-de-al-menos-32-caracteres"
TOKEN_SIGNING_SECRET="genera-otro-secreto-aleatorio-de-al-menos-32-caracteres"
EMAIL_USER=""
EMAIL_PASS=""
ADMIN_EMAIL=""
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
# Configuración de Proxy Inverso (Trust Proxy)
# false = (Por defecto) Más seguro. Usar si el backend se expone directamente.
# true = Confiar en todos los proxies (útil en plataformas como Render/Heroku/Vercel si administran IPs dinámicas).
# "1" = Confiar en el primer salto del proxy (si hay un Nginx directo delante).
# "127.0.0.1, 192.168.1.1" = Confiar en IPs específicas.
TRUST_PROXY="false"
PORT="3000"
