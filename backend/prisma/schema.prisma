}

model Producto {
  id          String   @id @default(uuid())
  titulo      String
  precio      Decimal
  descripcion String
  categoria   String   @default("General")
  imagenUrl   String   @map("imagen_url")
  driveUrl    String   @map("drive_url")
  cantidad    Int      @default(1)
  createdAt   DateTime @default(now())
  ordenes     Orden[]  @relation("OrdenProductos")

  @@map("productos")
}

model Orden {
  id            String       @id @default(uuid())
  emailCliente  String       @map("customer_email")
  total         Decimal
  estado        String       @default("PENDIENTE") // SQLite no admite enums en el schema de Prisma
  productos     Producto[]   @relation("OrdenProductos")

  @@map("ordenes")
}

model SolicitudLibro {
  id           String   @id @default(uuid())
  emailCliente String   @map("email_cliente")
  mensaje      String
  estado       String   @default("PENDIENTE") // PENDIENTE, NOTIFICANDO, NOTIFICADO, RESPONDIENDO, RESPONDIDO
  createdAt    DateTime @default(now())
  outboxes     NotificacionOutbox[]

  @@map("solicitudes_libros")
}

model NotificacionOutbox {
  id           String   @id @default(uuid())
  solicitudId  String
  tipo         String   @default("NUEVA_SOLICITUD") // NUEVA_SOLICITUD, AVISO_SUBIDA, RESPUESTA_SOLICITUD
  payload      String?  // JSON con datos extra (ej: existe: true)
  estado       String   @default("PENDIENTE") // PENDIENTE, EN_PROCESO, COMPLETADO, FALLIDO
  intentos     Int      @default(0)
  error        String?
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  solicitud    SolicitudLibro @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
}
